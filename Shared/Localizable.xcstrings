    "editor.whoNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a kid’s or partner’s name to set the goal and reward for them. Each person gets their own chart; swipe to switch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填孩子、伴侣的名字，就是给 TA 设的目标和奖励；每人一张表，左右滑切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填孩子、伴侶的名字，就是給 TA 設的目標和獎勵；每人一張表，左右滑切換。"
          }
        }
      }
    },
