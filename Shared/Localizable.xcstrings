    "settings.syncNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partners or co-parents: send the sync code, they paste it once under New chart and get the same chart with its stickers. Whoever adds stickers sends a new code; pasting it merges both sides."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "情侣、爸妈一起带娃：发同步口令，对方在「新表」里粘贴一次就有同一张表、连贴纸一起。谁贴了新的就再发一次，粘贴后两边自动合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "情侶、爸媽一起帶娃：傳同步口令，對方在「新表」裡貼上一次就有同一張表、連貼紙一起。誰貼了新的就再傳一次，貼上後兩邊自動合併。"
          }
        }
      }
    },
